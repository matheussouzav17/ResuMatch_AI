# Copie este arquivo para ".env" e preencha os valores.
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).

# Obrigatório: sua chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo do Claude (padrão: claude-opus-5-5; claude-sonnet-5-5 é mais barato)
CLAUDE_MODEL=claude-opus-5-5
# Opcional: esforço de raciocínio: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_TIMEOUT_SECONDS=180
CLAUDE_MAX_RETRIES=2

# Upload de documentos (PDF, DOCX, TXT): tamanho máximo por arquivo, em MB
MAX_UPLOAD_MB=5

# Leitura de vagas por URL
JOB_FETCH_TIMEOUT_SECONDS=15
JOB_FETCH_MAX_MB=3
# Proteção contra SSRF: mantenha false (bloqueia URLs da rede interna)
JOB_FETCH_ALLOW_PRIVATE_HOSTS=false

# Origens do frontend autorizadas (lista separada por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# development | production (em produção o /docs é desativado)
ENVIRONMENT=development
LOG_LEVEL=INFO
